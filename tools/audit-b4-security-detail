#!/usr/bin/env bash
# Inspect exact WPCS security findings, preserving Work and Base source.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
QA="$HOME/Downloads/core-blueprint-qa-tools"
OUT="$QA/reports/work-security-detail.json"
PHPCS="$QA/vendor/bin/phpcs"

[[ "$(git -C "$ROOT" branch --show-current)" == "audit/work-b4-security-static-qa-v1" || "$(git -C "$ROOT" branch --show-current)" == "feature/work-b4-2-security-final-golden-v1" ]] || exit 2
git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet || exit 2
[[ -x "$PHPCS" ]] || exit 2
mkdir -p "$QA/reports"

SECURITY_DIR="$QA/vendor/wp-coding-standards/wpcs/WordPress/Sniffs/Security"
mapfile -t NAMES < <(find "$SECURITY_DIR" -maxdepth 1 -name '*Sniff.php' -type f -printf '%f\n' | sed -e 's/Sniff.php$//' -e 's/^/WordPress.Security./' | LC_ALL=C sort)
(( ${#NAMES[@]} > 0 )) || exit 2
CODES="$(IFS=,; echo "${NAMES[*]}")"

set +e
"$PHPCS" --standard=WordPress-Extra --sniffs="$CODES" --extensions=php --report=json "$ROOT/src" "$ROOT/core-blueprint-work.php" > "$OUT"
status=$?
set -e

printf '=== Detailed security audit ===\n'
printf 'PHPCS exit: %s\nReport: %s\n' "$status" "$OUT"
python3 - "$OUT" <<'PY'
import collections
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    report = json.load(handle)

by_source = collections.Counter()
by_file = collections.Counter()
samples = {}
for path, record in report.get("files", {}).items():
    for msg in record.get("messages", []):
        source = msg.get("source", "unknown")
        by_source[source] += 1
        by_file[path] += 1
        samples.setdefault(source, []).append((path, msg.get("line", "?"), msg.get("message", "")))

print("=== Violations by exact sniff ===")
for name, count in by_source.most_common():
    print(f"{count:>4}  {name}")
    for filename, line, message in samples[name][:3]:
        print(f"      {filename}:{line}: {message[:130]}")
print("=== Most flagged files ===")
for filename, count in by_file.most_common(20):
    print(f"{count:>4}  {filename}")
print(f"Total listed messages: {sum(by_source.values())}")
print(f"PHPCS reported totals: {report.get('totals', {})}")
PY
