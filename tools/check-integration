#!/usr/bin/env bash
set -euo pipefail

# Core Blueprint Handbook Level 2: fully provisioned, Work-isolated WP PHPUnit.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fail() { printf 'Work integration BLOCKED: %s\n' "$*" >&2; exit 1; }

WP_VERSION="${CB_TEST_WP_VERSION:-7.0}"
[[ "$WP_VERSION" == "7.0" || "$WP_VERSION" == "7.1" ]] || fail "CB_TEST_WP_VERSION must be 7.0 or 7.1."
TEST_ROOT="${CB_TEST_ROOT:-/tmp/core-blueprint-tests/core-blueprint-work}"
# No arbitrary root deletion or unexpected paths; isolated disposable runs only.
[[ "$TEST_ROOT" == "/tmp/core-blueprint-tests/core-blueprint-work" ]] ||
  fail "CB_TEST_ROOT must be the canonical Work-specific temporary root."
BASE_SOURCE="${CB_TEST_BASE_SOURCE:-$HOME/Downloads/wp-core-blueprint}"
[[ -f "$BASE_SOURCE/core-blueprint.php" && -f "$BASE_SOURCE/vendor/autoload.php" &&
   -x "$BASE_SOURCE/vendor/bin/phpunit" ]] ||
  fail "Canonical Base checkout with locked Composer dev dependencies is required: $BASE_SOURCE"

DB_NAME="core_blueprint_work_test"
DB_HOST="${CB_TEST_DB_HOST:-127.0.0.1:3307}"
DB_USER="${CB_TEST_DB_USER:-root}"
DB_PASSWORD="${CB_TEST_DB_PASSWORD:-root}"
[[ "$DB_HOST" == "127.0.0.1:3307" && "$DB_USER" == "root" && "$DB_PASSWORD" == "root" ]] ||
  fail "This A1 integration runner is restricted to the canonical local Docker database."
for command_name in docker curl tar php git; do
  command -v "$command_name" >/dev/null 2>&1 || fail "Missing command: $command_name"
done

# No new containers, and never reset a database outside the exact Work-only name.
docker inspect cb-base-test-db >/dev/null 2>&1 ||
  fail "Canonical cb-base-test-db is unavailable. Restore it using the Engineering Handbook."
IMAGE="$(docker inspect --format '{{.Config.Image}}' cb-base-test-db)"
[[ "$IMAGE" == "mariadb:10.11.19" ]] || fail "Unexpected database image: $IMAGE"
PORT="$(docker port cb-base-test-db 3306/tcp 2>/dev/null || true)"
grep -Eq '(^|:)3307$' <<< "$PORT" || fail "cb-base-test-db does not expose host port 3307."
docker start cb-base-test-db >/dev/null 2>&1 || fail "Could not start existing canonical MariaDB container."
docker exec -e MYSQL_PWD="$DB_PASSWORD" cb-base-test-db mariadb -uroot \
  -e 'SELECT 1' >/dev/null || fail "Local MariaDB connection failed."

mkdir -p "$TEST_ROOT"
RUN_DIR="$(mktemp -d "$TEST_ROOT/run.XXXXXXXX")"
[[ "$RUN_DIR" == "$TEST_ROOT"/run.* ]] || fail "Unexpected integration run path."
cleanup() {
  if [[ -n "${RUN_DIR:-}" && -d "$RUN_DIR" &&
        "$RUN_DIR" == "$TEST_ROOT"/run.* ]]; then
    rm -rf -- "$RUN_DIR"
  fi
}
trap cleanup EXIT
export WP_CORE_DIR="$RUN_DIR/wp"
export WP_TESTS_DIR="$RUN_DIR/wp-tests"
export CB_TEST_BASE_SOURCE="$BASE_SOURCE"
export CB_TEST_BASE_PLUGIN_FILE="$WP_CORE_DIR/wp-content/plugins/core-blueprint/core-blueprint.php"
export CB_TEST_WORK_PLUGIN_FILE="$WP_CORE_DIR/wp-content/plugins/core-blueprint-work/core-blueprint-work.php"
export WP_DB_NAME="$DB_NAME" WP_DB_HOST="$DB_HOST"
export WP_DB_USER="$DB_USER" WP_DB_PASSWORD="$DB_PASSWORD"

mkdir -p "$WP_CORE_DIR" "$WP_TESTS_DIR"
printf 'Work integration: provision WordPress %s and wp-phpunit %s.0\n' "$WP_VERSION" "$WP_VERSION"
curl --fail --silent --show-error --location \
  "https://wordpress.org/wordpress-${WP_VERSION}.tar.gz" |
  tar -xz --strip-components=1 -C "$WP_CORE_DIR"
curl --fail --silent --show-error --location \
  "https://codeload.github.com/wp-phpunit/wp-phpunit/tar.gz/refs/tags/${WP_VERSION}.0" |
  tar -xz --strip-components=1 -C "$WP_TESTS_DIR"
[[ -f "$WP_CORE_DIR/wp-settings.php" &&
   -f "$WP_TESTS_DIR/includes/functions.php" ]] || fail "Incomplete WordPress/phpunit distribution."

mkdir -p "$(dirname "$CB_TEST_BASE_PLUGIN_FILE")" "$(dirname "$CB_TEST_WORK_PLUGIN_FILE")"
# Stage exact local source; do not mutate Base or Work checkouts.
tar -C "$BASE_SOURCE" \
  --exclude='./.git' --exclude='./vendor' --exclude='./tests' --exclude='./tools' \
  --exclude='./dist' --exclude='./build' --exclude='./.github' -cf - . |
  tar -C "$(dirname "$CB_TEST_BASE_PLUGIN_FILE")" -xf -
tar -C "$ROOT" \
  --exclude='./.git' --exclude='./dist' --exclude='./tests' --exclude='./tools' \
  --exclude='./build' --exclude='./.github' -cf - . |
  tar -C "$(dirname "$CB_TEST_WORK_PLUGIN_FILE")" -xf -
[[ -f "$CB_TEST_BASE_PLUGIN_FILE" && -f "$CB_TEST_WORK_PLUGIN_FILE" ]] ||
  fail "Staged Base / Work plugins missing."

# Exact name is a documented, disposable Work database. No other DB is touched.
docker exec -e MYSQL_PWD="$DB_PASSWORD" cb-base-test-db mariadb -uroot \
  -e "DROP DATABASE IF EXISTS \`$DB_NAME\`; CREATE DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" ||
  fail "Failed to initialize the isolated Work test database."

printf 'Work integration: source %s; Base %s; WordPress %s; MariaDB %s / %s\n' \
  "$(git -C "$ROOT" rev-parse HEAD)" "$(git -C "$BASE_SOURCE" rev-parse HEAD)" \
  "$WP_VERSION" "$DB_HOST" "$DB_NAME"
"$BASE_SOURCE/vendor/bin/phpunit" \
  -c "$ROOT/tests/phpunit-time-cas.xml.dist" \
  --do-not-cache-result --fail-on-skipped --fail-on-incomplete
printf 'Core Blueprint Work Level 2 integration: PASS\n'
