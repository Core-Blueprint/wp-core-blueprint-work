#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_SLUG="core-blueprint-work"
VERSION="$(php -r '$s=file_get_contents($argv[1]); preg_match("/Version:\\s+([^\\r\\n]+)/", $s, $m); echo trim($m[1] ?? "");' "$ROOT_DIR/core-blueprint-work.php")"

if [[ -z "$VERSION" ]]; then
  echo "Unable to determine plugin version." >&2
  exit 1
fi

BUILD_DIR="$ROOT_DIR/build"
STAGE_DIR="$BUILD_DIR/$PLUGIN_SLUG"
ZIP_PATH="$BUILD_DIR/${PLUGIN_SLUG}-${VERSION}.zip"
rm -rf "$BUILD_DIR"
mkdir -p "$STAGE_DIR"

rsync -a \
  --exclude='.git/' \
  --exclude='.github/' \
  --exclude='build/' \
  --exclude='tests/' \
  --exclude='tools/' \
  --exclude='*.zip' \
  "$ROOT_DIR/" "$STAGE_DIR/"

find "$STAGE_DIR" -type f -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null
(
  cd "$BUILD_DIR"
  zip -qr "$(basename "$ZIP_PATH")" "$PLUGIN_SLUG"
)

echo "$ZIP_PATH"
