#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() {
	printf 'Work checks failed: %s\n' "$*" >&2
	exit 1
}

for command in php python3 wp msgfmt node zip unzip sha256sum find sort touch git cmp; do
	command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done

php -r 'exit(version_compare(PHP_VERSION, "8.4", ">=") ? 0 : 1);' || fail "PHP 8.4 or newer is required"

"$ROOT/tools/i18n/check"

if grep -R -nF 'CB\Core\' "$ROOT/src" "$ROOT/core-blueprint-work.php" \
	|| grep -R -nF 'CB\\Core\\' "$ROOT/src" "$ROOT/core-blueprint-work.php"; then
	fail "legacy Base namespace references remain in Work runtime"
fi

legacy_public_hooks=(
	'cb_core_booted'
	'cb_core_register_extensions'
	'cb_core_register_settings'
	'cb_core_register_interoperability_implementations'
	'cb_core_module_status_definitions'
	'cb_core_dashboard_register_cards'
	'cb_core_capability_catalog'
	'cb_admin_theme_enqueue'
)
for hook in "${legacy_public_hooks[@]}"; do
	if grep -R -nF "$hook" "$ROOT/src" "$ROOT/core-blueprint-work.php" "$ROOT/tests"; then
		fail "legacy Base public hook remains in Work runtime or test fixtures: $hook"
	fi
done

while IFS= read -r -d '' file; do
	php -l "$file" >/dev/null || fail "PHP lint failed: $file"
done < <(find "$ROOT" -type f -name '*.php' -not -path '*/.git/*' -not -path '*/dist/*' -not -path '*/build/*' -print0)

if [[ -d "$ROOT/assets" ]]; then
	while IFS= read -r -d '' file; do
		node --check "$file" >/dev/null || fail "JavaScript syntax failed: $file"
	done < <(find "$ROOT/assets" -type f -name '*.js' -print0)
fi

