CB_RELEASE_DIST="$FIRST_DIST" "$ROOT/tools/build-release" >/dev/null
CB_RELEASE_DIST="$SECOND_DIST" "$ROOT/tools/build-release" >/dev/null

FIRST_ZIP="$FIRST_DIST/core-blueprint-work.zip"
SECOND_ZIP="$SECOND_DIST/core-blueprint-work.zip"
FIRST_SHA="$(sha256sum "$FIRST_ZIP" | awk '{print $1}')"
SECOND_SHA="$(sha256sum "$SECOND_ZIP" | awk '{print $1}')"

[[ "$FIRST_SHA" == "$SECOND_SHA" ]] || fail "deterministic package SHA mismatch: $FIRST_SHA != $SECOND_SHA"
cmp -s "$FIRST_ZIP" "$SECOND_ZIP" || fail "deterministic package bytes differ"

echo "Core Blueprint Work local checks passed."
